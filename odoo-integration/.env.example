# Credenciales de la API de Odoo (JSON-2)
# NUNCA versionar el archivo .env real en Git — copiar este archivo a .env
# y completar con los valores reales.
ODOO_URL=https://tu-instancia-odoo.com
ODOO_DATABASE=tu_base_de_datos
ODOO_API_KEY=tu_api_key

# Ruta a la base de datos SQLite del scraper
# (relativa al directorio de odoo-integration, o absoluta)
DB_PATH=../scraper-fabricacion/data/fabricacion.db
