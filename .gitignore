# Credenciales
# Reglas globales a propósito (no atadas a una carpeta puntual): antes eran
# "scraper-fabricacion/.env" y "odoo-integration/.env", así que un .env en la
# raíz, en un módulo nuevo, o un backup tipo .env.bak NO quedaban excluidos y
# se podían subir sin aviso con un `git add -A`.
.env
.env.*
!.env.example
# Mismo principio de reglas amplias: nombres de archivo de secretos que hoy
# no existen en el repo, pero que un futuro módulo o script suelto podría
# introducir sin que nadie piense en agregarlos acá a mano. credenciales.*
# reemplaza a la regla vieja (solo credenciales.txt), que ya cubre.
credenciales.*
secrets.*
*.pem
*.pfx
*.p12
id_rsa*
.netrc
token.txt
tokens.txt

# Bases de datos locales
*.db
*.db-journal
*.sqlite
*.sqlite3
scraper-fabricacion/data/

# Volcados y respaldos de datos: contienen nombres de clientes reales
# (proyectos, materiales) igual que la BD y los logs de arriba.
*.db.bak
*.dump
backup/
export/

# Volcados de reconocimiento del scraper (HTML del ERP en vivo con datos
# reales de proyectos/materiales de clientes) — ver
# scripts/manual_exploration/explorar_formulario_edicion.py
scripts/manual_exploration/output/

# Logs
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Locks y checkpoints en ejecución
scraper.lock

# Herramientas locales / configuración de editor, no forman parte del proyecto
.claude/
.obsidian/
.vscode/
.idea/
